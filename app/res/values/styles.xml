<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlNormal">@color/dim</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorControlHighlight">#33FFFFFF</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/dim</item>
        <item name="android:colorEdgeEffect">#33FFFFFF</item>
    </style>

    <style name="ChipText">
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dim</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.28</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dim</item>
    </style>
</resources>
